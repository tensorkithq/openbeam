# Required for semantic detection (platform-provided)
OPENROUTER_API_KEY=sk-or-...

# Optional overrides
# PORT=8080
# HOST=0.0.0.0
# DB_PATH=./data/openbeam.db
# OPENROUTER_EMBED_MODEL=qwen/qwen3-embedding-8b
# OPENROUTER_EMBED_DIM=4096
# RUST_LOG=info

# Semantic search index. data/embeddings.bin is a Git LFS file; if the build
# only has the pointer, the server fetches the real index from EMBEDDINGS_URL
# into EMBEDDINGS_DIR (mount a volume there so it survives redeploys).
# EMBEDDINGS_DIR=data
# EMBEDDINGS_URL=https://github.com/tensorkithq/openbeam/releases/download/embeddings-v1/embeddings.bin
# EMBEDDINGS_SHA256=c61d3176ff88178b626ae228e71ec9c15fa4b2b3a9a862bbe2e40c1953aa5d25
